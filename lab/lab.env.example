# Settings for lab/lab on this machine. Copy this file to lab/lab.env, which
# git ignores, and set the lab's real values there: the values here are
# examples, and the repository holds no address of a real lab.

# The address users browse to, through the host's reverse proxy: a host name
# of the lab's own, or a path of an existing site.
YK_LAB_PUBLIC_BASE_URL=https://www.example.com/yk

# The host's 127.0.0.1 port the container is published on: the upstream of
# the proxy (lab/nginx/yk-portal-lab.conf).
YK_LAB_PORT=8100
