# The lab image (lab/Dockerfile) gets the source tree, never local state:
# databases, keys, the environment, caches.
.git/
.venv/
**/__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
build/
dist/
# but packages, for the lab to install (lab/lab --deb)
!dist/*.deb
*.sqlite3
*.sqlite3-*
*.key
*.csv
.env
lab/lab.env
